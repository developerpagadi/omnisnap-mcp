{
  "name": "omnisnap-mcp",
  "version": "0.2.0",
  "description": "MCP server for OmniSnap AI Studio. Gives AI agents stability-scored test selectors, design tokens, visual captures and QA diagnostics from your real, logged-in browser session.",
  "type": "module",
  "bin": {
    "omnisnap-mcp": "src/index.js"
  },
  "main": "src/index.js",
  "files": [
    "src",
    "assets",
    "README.md",
    "LICENSE",
    "PROTOCOL.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "developerpagadi",
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "mcp-server",
    "claude",
    "cursor",
    "chrome-extension",
    "selectors",
    "xpath",
    "playwright",
    "selenium",
    "cypress",
    "testing",
    "qa",
    "page-object",
    "design-tokens",
    "screenshot",
    "accessibility"
  ],
  "bugs": {
    "url": "https://omnisnap.metago.in/support.html"
  },
  "homepage": "https://omnisnap.metago.in",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "node src/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ws": "^8.18.0",
    "zod": "^3.25.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
